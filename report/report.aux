\newlabel{sec:results}{{5}{3}{Results}{section.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Validation loss over training time. The smaller models drop fastest early on, since they fit many more steps per second, and then flatten. \texttt  {xl} and \texttt  {xxl} start higher but pass the smaller models and are still coming down at the one-hour mark, which says they are limited by compute rather than converged.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:curves}{{1}{3}{Validation loss over training time. The smaller models drop fastest early on, since they fit many more steps per second, and then flatten. \texttt {xl} and \texttt {xxl} start higher but pass the smaller models and are still coming down at the one-hour mark, which says they are limited by compute rather than converged}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces All 20 runs, sorted by final validation loss (the selection metric). ``Tokens'' is how many training tokens the run actually processed inside the one-hour budget. Test numbers are shown for completeness, but we did not use them to select the model (\S  \ref {sec:test}).}}{4}{table.2}\protected@file@percent }
\newlabel{tab:results}{{2}{4}{All 20 runs, sorted by final validation loss (the selection metric). ``Tokens'' is how many training tokens the run actually processed inside the one-hour budget. Test numbers are shown for completeness, but we did not use them to select the model (\S \ref {sec:test})}{table.2}{}}
\@writefile{toc}{\contentsline {paragraph}{(1) A compute-optimal sweet spot.}{4}{section*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(2) The data fraction barely matters.}{4}{section*.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: final validation loss against model size, one line per data fraction. Loss falls steeply from \texttt  {small} through \texttt  {xl}, then ticks back up at \texttt  {xxl}, leaving a sweet spot near 124M parameters. Right: loss against data fraction, one line per size. The lines are almost flat; within each size the four fractions differ by about 0.01 nats, and not even in a consistent direction.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:sizedata}{{2}{5}{Left: final validation loss against model size, one line per data fraction. Loss falls steeply from \texttt {small} through \texttt {xl}, then ticks back up at \texttt {xxl}, leaving a sweet spot near 124M parameters. Right: loss against data fraction, one line per size. The lines are almost flat; within each size the four fractions differ by about 0.01 nats, and not even in a consistent direction}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{(3) Test agrees with validation.}{5}{section*.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Final test result}{5}{subsection.5.1}\protected@file@percent }
\newlabel{sec:test}{{5.1}{5}{Final test result}{subsection.5.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Qualitative evaluation}{5}{subsection.5.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Estimating the compute-optimal size}{5}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Throughput against tokens seen in the hour. Right: throughput collapses as the model grows, from about 270k tokens/s for \texttt  {small} down to about 40k for \texttt  {xxl}. Left: so the larger models get through far fewer tokens in the same hour (about 985M for \texttt  {small} versus 144M for \texttt  {xxl}, roughly 7 times fewer), yet still reach lower loss per token, right up until \texttt  {xxl}, where too few tokens finally cost more than the extra capacity is worth.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:tension}{{3}{6}{Throughput against tokens seen in the hour. Right: throughput collapses as the model grows, from about 270k tokens/s for \texttt {small} down to about 40k for \texttt {xxl}. Left: so the larger models get through far fewer tokens in the same hour (about 985M for \texttt {small} versus 144M for \texttt {xxl}, roughly 7 times fewer), yet still reach lower loss per token, right up until \texttt {xxl}, where too few tokens finally cost more than the extra capacity is worth}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Left: best validation loss per size against parameters, with a quadratic fit in log-parameters whose vertex estimates the compute-optimal size ($N^\star \approx 130$M) for the one-hour budget, within noise of the empirical winner \texttt  {xl}. Right: loss against estimated compute $C\approx 6ND$; the smallest models deliver the least compute despite the identical wall-clock budget. The fit rests on five points, so read it as indicative, not precise.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:optfit}{{4}{6}{Left: best validation loss per size against parameters, with a quadratic fit in log-parameters whose vertex estimates the compute-optimal size ($N^\star \approx 130$M) for the one-hour budget, within noise of the empirical winner \texttt {xl}. Right: loss against estimated compute $C\approx 6ND$; the smallest models deliver the least compute despite the identical wall-clock budget. The fit rests on five points, so read it as indicative, not precise}{figure.4}{}}
